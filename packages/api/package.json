{
  "name": "@basbuddy/api",
  "version": "1.0.0",
  "private": true,
  "description": "M4 — BasBuddy REST API: Express server reading from Valkey + Postgres",
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "npm run migrate --workspace=@basbuddy/ingestion",
    "migrate:down": "npm run migrate:down --workspace=@basbuddy/ingestion",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build",
    "lint": "eslint src"

  },
  "dependencies": {
    "@basbuddy/shared": "*",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.2",
    "node-pg-migrate": "^7.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0"
  }
}

