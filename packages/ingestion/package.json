{
  "name": "@basbuddy/ingestion",
  "version": "1.0.0",
  "private": true,
  "description": "M1 — GTFS Static ingestion script: download, parse, upsert into Postgres",
  "scripts": {
    "ingest": "tsx src/ingest.ts",
    "migrate": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc --build"
  },
  "dependencies": {
    "@basbuddy/shared": "*",
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/pg": "^8.11.8",
    "tsx": "^4.19.0",
    "node-pg-migrate": "^7.7.0"
  }
}
