{
  "name": "@basbuddy/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for BasBuddy — API contracts, GTFS types, Valkey cache shapes",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build --force",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
