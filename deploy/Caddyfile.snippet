basbuddy.farisantoni.com {
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy REST API requests to Express backend
    handle /api/* {
        reverse_proxy 127.0.0.1:3001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Serve Frontend Single Page Application (PWA)
    handle {
        root * /home/basbuddy/basbuddy/packages/frontend/dist
        try_files {path} /index.html
        file_server {
            precompressed gzip zstd
        }
    }

    # Cache immutable static assets
    @static path /assets/* /registerSW.js /manifest.webmanifest
    header @static Cache-Control "public, max-age=31536000, immutable"

    # HTML and Service Worker must always revalidate
    @html_sw path / /index.html /sw.js
    header @html_sw Cache-Control "no-cache, no-store, must-revalidate"
}
