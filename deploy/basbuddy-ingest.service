[Unit]
Description=BasBuddy GTFS Static Ingestion One-Shot Run
After=network.target postgresql.service

[Service]
Type=oneshot
User=basbuddy
WorkingDirectory=/home/basbuddy/basbuddy
EnvironmentFile=/etc/basbuddy/.env
ExecStart=/usr/bin/node packages/ingestion/dist/ingest.js
StandardOutput=journal
StandardError=journal
SyslogIdentifier=basbuddy-ingest
