[Unit]
Description=BasBuddy GTFS-RT Poller (SINGLETON — Rate Limit Protected)
After=network.target valkey-server.service postgresql.service
Wants=valkey-server.service postgresql.service

[Service]
Type=simple
User=basbuddy
WorkingDirectory=/home/basbuddy/basbuddy
EnvironmentFile=/etc/basbuddy/.env
ExecStart=/usr/bin/node packages/poller/dist/poller.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=basbuddy-poller
ProtectSystem=full
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
