{
  "name": "basbuddy",
  "version": "1.0.0",
  "private": true,
  "description": "BasBuddy — Malaysia Live Transit & Bus Tracker. Data: data.gov.my / Prasarana (CC BY 4.0).",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@basbuddy/shared && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build --workspace=@basbuddy/shared && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e --workspace=@basbuddy/frontend",
    "migrate": "npm run migrate --workspace=@basbuddy/ingestion",
    "ingest": "npm run ingest --workspace=@basbuddy/ingestion",
    "poller": "npm run dev --workspace=@basbuddy/poller",
    "api": "npm run dev --workspace=@basbuddy/api",
    "frontend": "npm run dev --workspace=@basbuddy/frontend"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
