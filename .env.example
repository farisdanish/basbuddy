# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=basbuddy
POSTGRES_USER=basbuddy
POSTGRES_PASSWORD=changeme
# Full connection string (takes priority over individual vars if set)
# DATABASE_URL=postgresql://basbuddy:changeme@localhost:5432/basbuddy

# ── Valkey / Redis ────────────────────────────────────────────────────────────
VALKEY_HOST=localhost
VALKEY_PORT=6379
# VALKEY_PASSWORD=

# ── GTFS API ─────────────────────────────────────────────────────────────────
# No API key required — public endpoint
GTFS_STATIC_URL=https://api.data.gov.my/gtfs-static/prasarana?category=rapid-bus-kl
GTFS_REALTIME_URL=https://api.data.gov.my/gtfs-realtime/vehicle-position/prasarana?category=rapid-bus-kl

# ── Poller ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_MS=30000
# TTL (seconds) for vehicle / stop_etas keys in Valkey
VEHICLE_TTL_SECONDS=240
# Bounding box for RapidKL coverage area (lat/lon min/max).
# Vehicles outside this box are flagged/dropped (bad GPS guard, §9).
BOUNDS_LAT_MIN=2.5
BOUNDS_LAT_MAX=3.5
BOUNDS_LON_MIN=101.2
BOUNDS_LON_MAX=102.0
# Assumed average bus speed for naive ETA calc (km/h)
AVG_SPEED_KMH=25

# ── API Server ────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
# Comma-separated allowed origins for CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173

# ── Timezone ──────────────────────────────────────────────────────────────────
# All timestamps in the app must be interpreted in Asia/Kuala_Lumpur (UTC+8).
# This is enforced in application code; the server TZ should also be set.
TZ=Asia/Kuala_Lumpur

# ── Observability (optional for v1) ──────────────────────────────────────────
# LOG_LEVEL=info
